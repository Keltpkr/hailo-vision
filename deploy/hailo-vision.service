[Unit]
Description=Hailo Vision camera HTTP server
After=network-online.target hailort.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/kelt_/hailo-vision
Environment=CAMERA_USE_SUDO=0
ExecStart=/home/kelt_/hailo-vision/.venv/bin/python -u -m uvicorn app.camera_server:app --host 192.168.1.44 --port 8090
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
